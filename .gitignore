# ------------------------------------------------------------------ 数据与运行时产物
# 行情库 / 自选持仓等本地数据（体积大且含个人数据，不入库）
# 必须锚定到仓库根：写成 `data/` 会把 packages/data 这个数据层源码包一起忽略掉
/data/
!/data/.gitkeep

# ------------------------------------------------------------------ 密钥与本地配置
.env
.env.*
!.env.example
*.local

# ------------------------------------------------------------------ Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------------ Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/

# 前端构建产物
packages/web/dist/
packages/web/.vite/
dist/
*.tsbuildinfo

# ------------------------------------------------------------------ 测试/调试截图与临时输出
.shots/
*.log
# 本地启动日志（.logs/ 下是 api/前端/探测输出）
/.logs/
# 构建脚本的下载缓存（world-atlas 原始地理数据，产物已内联进 src/assets）
.cache/

# ------------------------------------------------------------------ 编辑器与系统
.idea/
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ------------------------------------------------------------------ 工具/会话数据
.workbuddy/
.claude/
