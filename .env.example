# 复制为 .env 后按需修改；不设置时全部使用默认值。
# 服务启动时由 `alphaforge_api.main` 自动读取（已存在的环境变量优先，不会被文件覆盖），
# 所以填完直接重启服务即可，不用手动 export。

# ------------------------------------------------------------------ 数据层
# 行情库路径（SQLite），相对仓库根目录或绝对路径。默认 data/alphaforge.db
AF_DB=data/alphaforge.db

# 历史日线保留根数，只影响同步时的默认抓取深度，可用 --bars 覆盖
AF_BARS=520

# ------------------------------------------------------------------ 持久化
# 用户数据（自选 / 持仓 / 成交流水）JSON 路径。默认 data/store.json
AF_STORE_PATH=data/store.json

# -------------------------------------------------------------------- 登录
# 凭证单独落在 data/auth.json（PBKDF2 哈希 + 会话表），与业务数据分开：
# 分享 store.json 不会连密码一起给出去。删掉 auth.json 即恢复内置默认密码。
# AF_AUTH_PATH=data/auth.json
#
# 会话有效期（天），默认 7
# AF_AUTH_SESSION_DAYS=7
#
# 内置默认账号固定为 admin / admin，首次登录后强制修改（改完 must_change 清除）。
# 本地工装（布局审计、截图脚本）没有登录态时，用下面这个开关跳过守卫：
# AF_AUTH_DISABLED=1

# -------------------------------------------------------------------- CORS
# 开发期前端跑在 5173 时需要放行；生产单进程托管可只留自身域名
AF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# ------------------------------------------------------- AI 模型（可选）
# 不配置时两处功能都自动降级为规则版、照常可用：
#   1. 自然语言选股：规则匹配不到的说法交给模型兜底解析
#   2. 盘中盯盘 + 收盘复盘：`/watch` 的持仓点评与当日总结
# 降级时接口返回 `source: "rule"`，页面标注「规则判断」，不会伪装成模型结论。
# 换成任何 OpenAI 兼容网关都可以，只要填对 base_url 与 model 名。
# base_url 常见写法（注意结尾的 /v1 不能少）：
#   DeepSeek    https://api.deepseek.com/v1        model: deepseek-chat
#   阿里通义     https://dashscope.aliyuncs.com/compatible-mode/v1   model: qwen-plus
#   智谱        https://open.bigmodel.cn/api/paas/v4   model: glm-4-flash
#   Kimi        https://api.moonshot.cn/v1         model: moonshot-v1-8k
#   OpenAI      https://api.openai.com/v1          model: gpt-4o-mini
# 填完重启服务，在 /watch 页点「测试模型」验证：通了会回一句「可用」，
# 不通会直接把 401 / 404 / 模型名错误的原因贴在页面上。
# AF_LLM_BASE_URL=https://api.openai.com/v1
# AF_LLM_API_KEY=
# AF_LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------- 以下供 compose 使用
# 宿主机映射端口（docker compose 读取）
AF_PORT=8000
