# 复制为 .env 后按需修改；不设置时全部使用默认值。
# 注意：AF_* 由应用自身读取，需在启动 uvicorn 前导出为环境变量。

# ------------------------------------------------------------------ 数据层
# 行情库路径（SQLite），相对仓库根目录或绝对路径。默认 data/alphaforge.db
AF_DB=data/alphaforge.db

# 历史日线保留根数，只影响同步时的默认抓取深度，可用 --bars 覆盖
AF_BARS=520

# ------------------------------------------------------------------ 持久化
# 用户数据（自选 / 持仓 / 成交流水）JSON 路径。默认 data/store.json
AF_STORE_PATH=data/store.json

# -------------------------------------------------------------------- CORS
# 开发期前端跑在 5173 时需要放行；生产单进程托管可只留自身域名
AF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# --------------------------------------------------- AI 问股模型兜底（可选）
# 不配置时自然语言选股走纯规则解析，功能完整可用；
# 配置后，规则匹配不到的说法会交给模型兜底解析。
# AF_LLM_BASE_URL=https://api.openai.com/v1
# AF_LLM_API_KEY=
# AF_LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------- 以下供 compose 使用
# 宿主机映射端口（docker compose 读取）
AF_PORT=8000
